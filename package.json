{
  "name": "website-to-markdown",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:chrome": "wxt --browser chrome",
    "build": "wxt build --browser chrome",
    "build:benchmark": "wxt build --config wxt.config.benchmark.ts --browser chrome",
    "zip": "wxt zip --browser chrome",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "wxt prepare && tsc --noEmit",
    "benchmark:conversion": "CONVERSION_BENCHMARK=1 vitest run tests/conversion-benchmark.test.ts",
    "browser:install": "playwright install chromium",
    "evaluate:website": "tsx src/evaluation/cli.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.4.12",
    "fflate": "^0.8.3",
    "marked": "^18.0.7",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/chrome": "0.2.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.10.1",
    "@types/turndown": "^5.0.5",
    "jsdom": "^30.0.0",
    "linkedom": "^0.18.13",
    "playwright": "^1.61.0",
    "tsx": "^4.21.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wxt": "0.20.27"
  }
}
